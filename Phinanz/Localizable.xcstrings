    "Anyone who gets the file can read your finances. Protect it unless you keep it somewhere safe.": {
      "comment": "A description of the security of a backup.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer die Datei bekommt, kann deine Finanzen lesen. Schütze sie, außer du bewahrst sie sicher auf."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کس فایل را داشته باشد می‌تواند وضعیت مالی‌ات را بخواند. مگر اینکه جای امنی نگهش داری، با رمز محافظتش کن."
          }
        }
      }
    },
