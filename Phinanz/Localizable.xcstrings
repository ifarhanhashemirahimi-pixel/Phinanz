            "state" : "translated",
            "value" : "یعنی ماهی %@."
          }
        }
      }
    },
    "The backup from %@ contains %lld entries. Your current data will be replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup vom %1$@ enthält %2$lld Einträge. Deine aktuellen Daten werden ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The backup from %1$@ contains %2$lld entries. Your current data will be replaced."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبان %1$@ شامل %2$lld مورد است. داده‌های فعلی‌ات جایگزین می‌شوند."
          }
        }
      }
    },
    "The backup is encrypted with AES-256. Keep the password safe: without it the backup cannot be restored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup wird mit AES-256 verschlüsselt. Bewahre das Passwort gut auf: Ohne es lässt sich das Backup nicht wiederherstellen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبان با AES-256 رمزگذاری می‌شود. رمز را جای امن نگه دار؛ بدون آن پشتیبان بازگردانی نمی‌شود."
          }
        }
      }
    },
    "The file could not be opened." : {
      "comment" : "A message displayed when a file can't be opened.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht geöffnet werden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل باز نشد."
          }
        }
      }
    },
    "The file could not be read as text." : {
      "comment" : "Error message when the file cannot be read as text.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht als Text gelesen werden."
          }
