            "value" : "می‌گوید امروز چقدر خرج کرده‌ای."
          }
        }
      }
    },
    "That is %@ a month." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind %@ pro Monat."
          }
