    "Backups can be encrypted with AES-256. Without the password nobody can read them — not even PHINANZ.": {
      "comment": "Text displayed in a row in the security overview for a password-protected backup.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups lassen sich mit AES-256 verschlüsseln. Ohne Passwort kann sie niemand lesen – nicht einmal PHINANZ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان‌ها با AES-256 رمزگذاری می‌شوند. بدون رمز عبور هیچ‌کس نمی‌تواند آن‌ها را بخواند؛ حتی PHINANZ."
          }
        }
      }
    },
