        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجاره، اشتراک‌ها، بیمه یا حقوقت را اضافه کن. PHINANZ هر ماه آن‌ها را خودکار ثبت می‌کند."
          }
        }
      }
    },
