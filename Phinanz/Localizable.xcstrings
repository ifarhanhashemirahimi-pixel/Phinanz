    "A Page for Every Day": {
      "comment": "Title of the first feature row in the onboarding view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite für jeden Tag"
