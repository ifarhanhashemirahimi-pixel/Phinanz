          }
        }
      }
    },
    "Journal" : {
      "comment" : "The name of the tab for the journal view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal"
