    },
    "A short reminder in the evening to write down your spending, and a note the day before rent, subscriptions or salary.": {
      "comment": "The body of the footer for the reminders section.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Erinnerung am Abend, deine Ausgaben einzutragen, und ein Hinweis am Tag vor Miete, Abos oder Gehalt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یادآوری کوتاه عصرها برای نوشتن خرج‌ها، و یک یادداشت یک روز پیش از اجاره، اشتراک‌ها یا حقوق."
          }
        }
      }
    },
    "AI Import": {
      "comment": "Label for the AI consent toggle.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Import"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واردکردن با هوش مصنوعی"
          }
        }
      }
    },
    "AI can make mistakes. Check every entry before saving.": {
      "comment": "A description of the benefits of reviewing AI-suggested entries before saving.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI kann Fehler machen. Prüfe jeden Eintrag vor dem Speichern."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هوش مصنوعی ممکن است اشتباه کند. پیش از ذخیره، همهٔ موارد را بررسی کن."
          }
        }
      }
    },
    "AI import is turned off. Enable it in Settings to send recordings, photos or PDFs to Google Gemini.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Import ist aus. Aktiviere ihn in den Einstellungen, um Aufnahmen, Fotos oder PDFs an Google Gemini zu senden."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واردکردن با هوش مصنوعی خاموش است. برای فرستادن ضبط صدا، عکس یا PDF به Google Gemini آن را در تنظیمات روشن کن."
