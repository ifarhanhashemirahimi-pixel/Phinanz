    "Add rent, subscriptions, insurance or your salary. PHINANZ books them automatically every month.": {
      "comment": "A description of the recurring payments feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Miete, Abos, Versicherungen oder dein Gehalt hinzu. PHINANZ bucht sie jeden Monat automatisch."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجاره، اشتراک‌ها، بیمه یا حقوقت را اضافه کن. PHINANZ هر ماه آن‌ها را خودکار ثبت می‌کند."
          }
        }
      }
    },
