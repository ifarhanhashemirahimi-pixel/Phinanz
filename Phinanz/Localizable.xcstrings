          }
        }
      }
    },
    "What was in the account before your first entry in PHINANZ. Negative for a credit card you owe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was vor deinem ersten Eintrag in PHINANZ auf dem Konto war. Negativ bei einer Kreditkarte mit offenem Betrag."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مبلغی که پیش از اولین ثبت در PHINANZ در حساب بود. برای کارت اعتباری بدهکار، منفی وارد کن."
          }
        }
      }
    },
    "When you analyse a voice note, receipt photo or PDF statement, that file is sent to Google's Gemini API to extract entries. Nothing is sent otherwise, and nothing is saved until you confirm it. Your key stays in the iOS Keychain on this device." : {
      "comment" : "A description of the AI settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Sprachnotiz, ein Belegfoto oder einen PDF-Kontoauszug auswertest, wird genau diese Datei an die Gemini-API von Google gesendet. Sonst wird nichts gesendet, und nichts wird ohne deine Bestätigung gespeichert. Dein Schlüssel bleibt im iOS-Schlüsselbund auf diesem Gerät."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی یادداشت صوتی، عکس رسید یا صورت‌حساب PDF را تحلیل می‌کنی، فقط همان فایل به API جمینای گوگل فرستاده می‌شود. جز این چیزی فرستاده نمی‌شود و تا تأیید نکنی چیزی ذخیره نمی‌شود. کلیدت در Keychain همین دستگاه می‌ماند."
          }
        }
      }
    },
    "Where did you spend it?" : {
      "comment" : "Prompt for the user to enter the name of the store where they spent the money.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
